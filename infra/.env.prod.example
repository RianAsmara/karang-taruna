# Production environment for infra/docker-compose.prod.yml.
# Copy to infra/.env.prod and fill in. NEVER commit the filled copy.
#
# Generate each secret with: openssl rand -base64 32

APP_NAME=RukunMuda
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show — set ONCE, then never rotate:
                              # rotating invalidates every session, Sanctum token, and encrypted column
APP_DEBUG=false               # a stack trace shown to an end user is information disclosure
APP_URL=https://app.rukunmuda.id
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# Caddy: the domain's A record must already point at this VPS before the
# first `up`, or certificate issuance fails.
APP_DOMAIN=app.rukunmuda.id
ACME_EMAIL=you@example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning             # `debug` in production is noisy and leaks more than intended

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rukunmuda
DB_USERNAME=rukunmuda
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=predis

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true    # required once served over HTTPS
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=rukunmuda
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# The exact origins, never `*` — a production API a real mobile client
# authenticates against must not accept credentialed cross-origin requests
# from anywhere.
CORS_ALLOWED_ORIGINS=https://app.rukunmuda.id

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@rukunmuda.id
MAIL_FROM_NAME="${APP_NAME}"

# Error reporting. Without this a production failure is invisible until a
# member reports it. See infra/README.md.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Where pg-backup.sh writes, and how many daily dumps it keeps.
BACKUP_DIR=/var/backups/rukunmuda
BACKUP_RETAIN_DAYS=14
