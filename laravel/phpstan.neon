includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Sanctum's own published config stub — env()'s bool|string return type
    # for the default expression, not application code we maintain.
    ignoreErrors:
        - '#Parameter \#2 \$string of function explode expects string, bool\|string given\.#'
